# Copy to ~/.config/agilex5/hardware.env on the Linux HOST, edit, then source.
# These are configuration placeholders. Nothing is programmed by sourcing this.
export AGILEX_CONTAINER=agilex-hardware
export AGILEX_CONTAINER_USER=dev
export AGILEX_CONTAINER_ROOT=/absolute/container/path/baremetal-drivers/examples/agilex5-modular
export AGILEX_UART=/dev/serial/by-path/CHANGE-ME-TO-VERIFIED-SOM-J2

# FPGA-first 26.3 stack: directory containing the matching ddr_recovery.sof.
export AGILEX_BOOTSTRAP_DIR=/absolute/host/path/to/matched/boot
export AGILEX_FORCE_FULL_BOOT=1
# Every checkout and debugger must share this same lock inode.
export AGILEX_HARDWARE_LOCK=/absolute/host/path/to/shared/hardware.lock
