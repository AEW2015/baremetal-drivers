# Optional Linux/WSL shell environment. Prefer repo-root `python3 lab.py configure`.
# Source this while in examples/agilex5-modular; no board is accessed.
export AGILEX_EXECUTION=native
export AGILEX_BOOTSTRAP_DIR="$PWD/build/boot"
export AGILEX_MCP_CLIENT="$PWD/mcp_client.py"
export AGILEX_HARDWARE_LOCK="$PWD/hardware.lock"
export AGILEX_FORCE_FULL_BOOT=1
export AGILEX_UART=/dev/serial/by-path/CHANGE-ME-TO-VERIFIED-SOM-J2
# For an existing tools container instead of native tools:
# export AGILEX_EXECUTION=container
# export AGILEX_CONTAINER=YOUR-TOOLS
# export AGILEX_CONTAINER_ROOT=/work/examples/agilex5-modular
# export AGILEX_CONTAINER_USER=dev
