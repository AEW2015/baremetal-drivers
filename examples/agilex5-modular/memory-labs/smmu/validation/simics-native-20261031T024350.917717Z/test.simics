 bp.wait-for-breakpoint $ready
 stop
 $con.input "ddr_selftest\n"
 run
 bp.wait-for-breakpoint $ready
 stop
 echo "NATIVE_TBU_DDR_BOOTSTRAP_COMPLETE"
 @import sys
 @sys.path.insert(0,"/workspace/baremetal-fixes-20261029/examples/agilex5-modular/memory-labs/smmu")
 @import native_cases
 @native_cases.run_cases("/workspace/baremetal-fixes-20261029/examples/agilex5-modular/memory-labs/smmu/validation/simics-native-20261031T024350.917717Z/native-results.json")
}
