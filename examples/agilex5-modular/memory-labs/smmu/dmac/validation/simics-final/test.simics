$fsbl_image_filename = "/workspace/baremetal-fixes-20261029/examples/agilex5-modular/build/upstream26-ocram/baremetal.bin"
$hps_reset_vector = 0
run-script (sim->project + "/targets/agilex5e-universal/agilex5e-universal.simics")
$con = $system.board.fpga.soc_inst.hps_subsys.agilex_hps.console0.con
$ready = (bp.console_string.break $con "SoCFPGA Bare-Metal > ")
$phase1 = (bp.console_string.break $con -regexp "(DMAC_SMMU_PHASE1_COMPLETE|LAB FAILED)")
$done = (bp.console_string.break $con -regexp "LAB (COMPLETE|FAILED)")
$con.record-start
@import sys; sys.path.insert(0,"/workspace/baremetal-fixes-20261029/examples/agilex5-modular/memory-labs/smmu/dmac"); sys.path.insert(0,"/workspace/baremetal-fixes-20261029/examples/agilex5-modular/memory-labs/smmu"); import native_dmac
script-branch {
 run
 bp.wait-for-breakpoint $ready
 stop
 $con.input "ddr_selftest\n"
 run
 bp.wait-for-breakpoint $ready
 stop
 echo "SIMICS_DDR_BOOTSTRAP_COMPLETE"
 @native_dmac.safe(native_dmac.configure,"/workspace/baremetal-fixes-20261029/examples/agilex5-modular/memory-labs/smmu/dmac/validation/simics-final/native.json")
 hps.phys_mem.load-file "/workspace/baremetal-fixes-20261029/examples/agilex5-modular/build/memory-smmu-dmac/dmac-smmu.bin" 0x82400000
 pselect "system.board.fpga.soc_inst.hps_subsys.agilex_hps.core[0]"
 set-pc 0x82400000
 run
 bp.wait-for-breakpoint $phase1
 stop
 @native_dmac.safe(native_dmac.after_phase1)
 run
 bp.wait-for-breakpoint $done
 stop
 @native_dmac.safe(native_dmac.finish)
 $transcript = ($con.record-stop)
 echo "UART_RECORD_BEGIN"
 echo $transcript
 echo "UART_RECORD_END"
 exit 0
}
