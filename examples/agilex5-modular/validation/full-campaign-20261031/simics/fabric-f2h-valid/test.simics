$fsbl_image_filename = "/workspace/baremetal-fixes-20261029/examples/agilex5-modular/build/upstream26-ocram/baremetal.bin"
$hps_reset_vector = 0
run-script (sim->project + "/targets/agilex5e-universal/agilex5e-universal.simics")
@import sys
@sys.path.insert(0, "/workspace/baremetal-fixes-20261029/examples/agilex5-modular/memory-labs/fabric-ddr/simics")
@import fabric_adapter
@bridge = fabric_adapter.install("/workspace/baremetal-fixes-20261029/examples/agilex5-modular/build/fabric-ddr-simics/rtl-ns/Vddr_probe", "/workspace/baremetal-fixes-20261029/examples/agilex5-modular/validation/full-campaign-20261031/simics/fabric-f2h-valid/transactions.jsonl", "f2soc", "none")
$con = $system.board.fpga.soc_inst.hps_subsys.agilex_hps.console0.con
$ready = (bp.console_string.break $con "SoCFPGA Bare-Metal > ")
$done = (bp.console_string.break $con -regexp "LAB (COMPLETE|FAILED)")
$con.record-start
script-branch {
 run
 bp.wait-for-breakpoint $ready
 stop
 $con.input "ddr_selftest\n"
 run
 bp.wait-for-breakpoint $ready
 stop
 echo "FABRIC_DDR_BOOTSTRAP_COMPLETE"
 @fabric_adapter.configure_native(False)
 hps.phys_mem.load-file "/workspace/baremetal-fixes-20261029/examples/agilex5-modular/build/fabric-ddr-simics/translated.bin" 0x82400000
 pselect "system.board.fpga.soc_inst.hps_subsys.agilex_hps.core[0]"
 set-pc 0x82400000
 run
 bp.wait-for-breakpoint $done
 stop
 @fabric_adapter.finish_native()
 @bridge.close()
 $transcript = ($con.record-stop)
 echo "UART_RECORD_BEGIN"
 echo $transcript
 echo "UART_RECORD_END"
 exit 0
}
