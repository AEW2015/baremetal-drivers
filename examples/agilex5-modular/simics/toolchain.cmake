# The upstream application is freestanding; record the compiler actually used.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{UPSTREAM_CROSS_COMPILE})
  set(PREFIX "$ENV{UPSTREAM_CROSS_COMPILE}")
else()
  set(PREFIX aarch64-linux-gnu-)
endif()
set(CMAKE_C_COMPILER ${PREFIX}gcc)
set(CMAKE_ASM_COMPILER ${PREFIX}gcc)
set(CMAKE_OBJCOPY ${PREFIX}objcopy CACHE FILEPATH "" FORCE)
set(CMAKE_OBJDUMP ${PREFIX}objdump CACHE FILEPATH "" FORCE)
set(CMAKE_SIZE ${PREFIX}size CACHE FILEPATH "" FORCE)
