/* Local bring-up hook: run after vendor DDR init and before storage boot. */
static void local_ddr_probe(void)
{
    volatile uint64_t *mem = (volatile uint64_t *)0x84000000UL;
    const size_t words = (64UL * 1024 * 1024) / sizeof(uint64_t);
    const uint64_t patterns[] = {0, ~0ULL, 0xaaaaaaaa55555555ULL, 0x55555555aaaaaaaaULL};
    NOTICE("LOCAL DDR: 64 MiB uncached test at 0x84000000, four address-dependent patterns\n");
    for (unsigned int pass = 0; pass < 4; pass++) {
        for (size_t i = 0; i < words; i++)
            mem[i] = patterns[pass] ^ ((uint64_t)i * 0x9e3779b97f4a7c15ULL);
        dsbsy();
        for (size_t i = 0; i < words; i++) {
            uint64_t expected = patterns[pass] ^ ((uint64_t)i * 0x9e3779b97f4a7c15ULL);
            uint64_t actual = mem[i];
            if (actual != expected) {
                ERROR("LOCAL DDR FAIL: pass=%u address=0x%lx expected=0x%llx actual=0x%llx\n",
                    pass, (unsigned long)&mem[i], (unsigned long long)expected, (unsigned long long)actual);
                panic();
            }
        }
        NOTICE("LOCAL DDR: pattern %u PASS (67108864 bytes)\n", pass);
    }
    static const unsigned char payload[] = {PAYLOAD_BYTES};
    volatile unsigned char *target = (volatile unsigned char *)0x82000000UL;
    for (size_t i=0; i<sizeof(payload); i++) target[i] = payload[i];
    dsbsy();
    for (size_t i=0; i<sizeof(payload); i++) if (target[i] != payload[i]) panic();
    flush_dcache_range(0x82000000UL, sizeof(payload));
    __asm__ volatile("ic iallu; dsb sy; isb");
    NOTICE("LOCAL DDR: payload readback PASS, entering DDR code at 0x82000000\n");
    console_flush();
    ((void (*)(void))0x82000000UL)();
    panic();
}
