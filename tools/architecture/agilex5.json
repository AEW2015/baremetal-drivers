      "source": "examples/agilex5-modular/bootstrap/ocram/uart_local.c"
    },
    {
      "path": "/HPS/Memory/MPFE",
      "title": "Multi-port front end",
      "role": "DDR access and security windows; simplified placement",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/Peripherals",
      "title": "HPS peripheral subsystem",
      "role": "Named controllers, not all physical instances",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/Peripherals/UART0",
      "title": "UART0 / DW16550",
      "role": "SOM J2 console; preserve handoff baud divisor",
