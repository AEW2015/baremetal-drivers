{
  "schema": 1,
  "scope": "Educational TRM-based functional grouping, not an extracted Quartus netlist. Board-specific assertions come from the bench profile; proposed fabric and Simics-only contexts are explicit.",
  "nodes": [
    {
      "path": "/HPS",
      "title": "Hard Processor System",
      "role": "Hard CPU, memory, peripherals and control",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/MPU",
      "title": "Arm processor subsystem",
      "role": "Two A55 and two A76 cores; shared CPU lessons",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/MPU/A55",
      "title": "Dual Cortex-A55",
      "role": "Boot core and second A55; MIDR/MPIDR verified",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/MPU/A76",
      "title": "Dual Cortex-A76",
      "role": "Two secondary A76 cores; execution verified",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/MPU/MMU_NEON",
      "title": "CPU MMU / NEON / exceptions",
      "role": "Architectural CPU functions, not fabric IP",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/MPU/Generic_timer",
      "title": "Arm generic timer",
      "role": "Secure physical timer FIQ lesson; ten interrupts",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/Memory",
      "title": "Memory and interconnect",
      "role": "Simplified functional grouping; not a wiring netlist",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/Memory/CCU",
      "title": "Cache coherency unit",
      "role": "Register checks do not qualify cache coherency",
      "scope": "TRM architecture",
      "address": "0x1c000000",
      "source": "platform/agilex5/include/socfpga_peripheral_reg_plat.h"
    },
    {
      "path": "/HPS/Memory/SMMU",
      "title": "System memory management unit",
      "role": "ID checks are separate from DMA translation",
      "scope": "TRM architecture",
      "address": "0x16000000",
      "source": "platform/agilex5/include/socfpga_peripheral_reg_plat.h"
    },
    {
      "path": "/HPS/Memory/NoC",
      "title": "NoC and firewalls",
      "role": "Access control, probes and error status",
      "scope": "TRM architecture",
