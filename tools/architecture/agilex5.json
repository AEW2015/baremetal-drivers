      "title": "Power manager",
      "role": "Secondary-core reset/power release",
      "scope": "TRM architecture"
    },
    {
      "path": "/HPS/Control/ECC",
      "title": "ECC control",
      "role": "Register/default reads do not prove injected-error recovery",
